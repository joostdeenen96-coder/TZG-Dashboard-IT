# Kopieer naar .env op de server (nooit committen).
# Docker Compose leest deze variabelen en geeft ze door aan de container.

PORT=8080

# Microsoft Graph (client credentials) — verplicht voor live diesel/nieuws/agenda
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# PostgreSQL — vervang change-me; commit geen echte wachtwoorden
POSTGRES_DB=tzg
POSTGRES_USER=tzg
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://tzg:change-me@postgres:5432/tzg

# Schermstatus (seconden). Geen businessregels in code.
SCREEN_HEARTBEAT_SECONDS=60
SCREEN_OFFLINE_AFTER_SECONDS=180
SCREEN_HEARTBEAT_RETENTION_DAYS=14

# Optioneel: json alleen voor expliciet lokaal herstel. Productie gebruikt postgres.
# DASHBOARD_REPOSITORY=postgres

# Optioneel: PRTG voor /ict
PRTG_BASE_URL=
PRTG_USERNAME=
PRTG_PASSHASH=
PRTG_PASSWORD=
PRTG_GROUP_ID=
PRTG_TAG=
PRTG_TLS_INSECURE=
