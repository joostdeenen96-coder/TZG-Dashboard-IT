# Microsoft Graph, client credentials.
# Dit voorbeeld hoort in release\.env.example.
# install-dashboard.bat kopieert het naar de projectmap als .env, alleen als die nog ontbreekt.
# Vul de drie waarden in. Het client secret blijft in .env en gaat niet de repository in.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# PRTG HTTP API voor het ICT-scherm op /ict.
# Basisadres: https://prtg.voorbeeld.local (niet /index.htm).
# Gebruik PRTG_PASSHASH of PRTG_PASSWORD. Nooit loggen of committen.
# Optioneel: PRTG_GROUP_ID (nummer uit de PRTG-URL) of PRTG_TAG.
PRTG_BASE_URL=
PRTG_USERNAME=
PRTG_PASSHASH=
PRTG_PASSWORD=
PRTG_GROUP_ID=
PRTG_TAG=
