# Kopieer naar .env op de server (nooit committen).
# Docker Compose leest deze variabelen en geeft ze door aan de container.

NODE_ENV=production
PORT=8080
LOG_LEVEL=info
APP_VERSION=0.4.1
BUILD_COMMIT=unknown
BUILD_DATE=

# Microsoft Graph (client credentials) — alleen invullen als Graph aan staat
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# PostgreSQL — vervang change-me; commit geen echte wachtwoorden
POSTGRES_DB=tzg
POSTGRES_USER=tzg
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://tzg:change-me@postgres:5432/tzg

# Schermstatus (seconden). Geen businessregels in code.
SCREEN_HEARTBEAT_SECONDS=60
SCREEN_OFFLINE_AFTER_SECONDS=180
SCREEN_HEARTBEAT_RETENTION_DAYS=14

# Backups (voorstel, configureerbaar)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_DIRECTORY=/backups
BACKUP_MAX_AGE_HOURS=36

# Reverse proxy (NGINX in docker-compose). Standaard 1 hop.
TRUST_PROXY=1
CERT_CN=nc.teunesen.nl
CERT_DAYS=3650

# Host-poort 8080 publiceren (true = huidige gedrag). false = alleen via nginx 80/443.
# Bij false: COMPOSE_FILE=docker-compose.yml:docker-compose.expose-internal.off.yml
EXPOSE_INTERNAL_PORT=true

# Optioneel: json alleen voor expliciet lokaal herstel. Productie gebruikt postgres.
# DASHBOARD_REPOSITORY=postgres

# Optioneel: PRTG voor /ict
PRTG_BASE_URL=
PRTG_USERNAME=
PRTG_PASSHASH=
PRTG_PASSWORD=
PRTG_GROUP_ID=
PRTG_TAG=
PRTG_TLS_INSECURE=
