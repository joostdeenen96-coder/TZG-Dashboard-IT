{
  "name": "teunesen-dashboard",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx server/index.ts\" vite",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit --pretty false",
    "test": "tsx --test server/appPaths.test.ts server/services/healthService.test.ts server/dashboards/model.test.ts server/dashboards/repository.test.ts server/routes/dashboards.test.ts server/screens/token.test.ts server/screens/status.test.ts server/legacyPaths.test.ts server/db/repositoryMode.test.ts server/db/platform003.test.ts server/config.test.ts server/log.test.ts server/player/backoff.test.ts server/platform004.test.ts",
    "config:validate": "tsx server/scripts/config-validate.ts",
    "backup:create": "tsx server/scripts/backup-create.ts",
    "backup:list": "tsx server/scripts/backup-list.ts",
    "backup:verify": "tsx server/scripts/backup-verify.ts",
    "backup:cleanup": "tsx server/scripts/backup-cleanup.ts",
    "backup:restore-test": "tsx server/scripts/backup-restore-test.ts",
    "db:migrate": "tsx server/scripts/db-migrate.ts",
    "db:migrate:status": "tsx server/scripts/db-migrate-status.ts",
    "db:seed": "tsx server/scripts/db-seed.ts",
    "db:export": "tsx server/scripts/db-export.ts",
    "db:import-json": "tsx server/scripts/db-import-json.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "express": "^5.3.0",
    "framer-motion": "^14.2.0",
    "lucide-react": "^1.56.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
